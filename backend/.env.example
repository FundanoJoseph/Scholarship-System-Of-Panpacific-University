# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill it in.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# local    -> the API checks passwords itself (bcrypt) and issues its own JWT.
#             Use this to run everything on your machine with no Supabase project.
# supabase -> passwords and sessions live in Supabase Auth; the API verifies the
#             access token Supabase issues.
AUTH_PROVIDER=local

# Used when AUTH_PROVIDER=local. Change it to a long random value.
JWT_SECRET=dev-secret-change-me-please-replace-0123456789
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=14

# sqlite:///./var/dev.db                        (local development)
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./var/dev.db

# Documents: local disk, or a Supabase Storage bucket
STORAGE_BACKEND=local
STORAGE_BUCKET=scholarship-documents
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=5

# --- Supabase (only needed when AUTH_PROVIDER/STORAGE_BACKEND are supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Only for projects still using the legacy HS256 shared-secret signing keys.
SUPABASE_JWT_SECRET=
# Where the recovery email should send the user back to.
PASSWORD_RESET_REDIRECT=http://localhost:8000/template/reset-password.html
FRONTEND_URL=http://localhost:8000

UNIVERSITY_EMAIL_DOMAIN=@panpacificu.edu.ph

# Comma separated. Only needed when the frontend is hosted somewhere else
# (for example GitHub Pages pointing at a deployed API).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Serve index.html / template / css / js / assets from this API.
# Only those website folders are published; the repository root is never exposed.
SERVE_FRONTEND=true
FRONTEND_DIR=..

# Optional: the public address of this API. Render fills it in automatically.
# Used for links that leave the app (for example the password recovery e-mail).
PUBLIC_BASE_URL=

# Development only: create the sample accounts and applications on startup.
# Leave false anywhere public.
SEED_DEMO_ACCOUNTS=false
